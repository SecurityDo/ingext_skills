{
  "staleDays": 30,
  "sources": [
    {
      "name": "SentinelOne",
      "label": "SentinelOne",
      "scope": "SentinelOne agent inventory, decommissioned agents excluded",
      "resource": "sentinelOneAgent",
      "filter": {"isDecommissioned": false},
      "host": "computerName",
      "ip": "lastIpToMgmt",
      "os": "osName",
      "lastSeen": "lastActiveDate",
      "required": true
    },
    {
      "name": "Defender",
      "label": "Defender",
      "scope": "Microsoft Defender for Endpoint machines that are onboarded and not excluded",
      "resource": "msDefenderMachine",
      "filter": {"onboardingStatus": "Onboarded", "isExcluded": false},
      "host": "computerDnsName",
      "deviceId": "aadDeviceId",
      "ip": ["lastIpAddress", "ipAddresses.ipAddress"],
      "os": "osPlatform",
      "lastSeen": "lastSeen",
      "required": true
    },
    {
      "name": "Entra",
      "label": "Entra ID",
      "scope": "Entra ID devices that are enabled and Entra-joined or hybrid-joined (Windows and macOS)",
      "resource": "office365Device",
      "filter": {
        "accountEnabled": true,
        "operatingSystem": ["Windows", "MacMDM", "macOS"],
        "trustType": ["AzureAd", "ServerAd"]
      },
      "host": "displayName",
      "deviceId": "deviceId",
      "idAuthority": true,
      "os": "operatingSystem",
      "lastSeen": "approximateLastSignInDateTime",
      "required": false,
      "missingLabel": "Not joined"
    },
    {
      "name": "Horizon3",
      "label": "Horizon3",
      "scope": "hosts that Horizon3.ai NodeZero internal pentests found on the network in the last 90 days",
      "resource": "horizon3Host",
      "filter": {
        "InScope": true,
        "pentest.opType": {"not": ["ExternalAttack", "AWSPentest", "AzurePentest", "K8sPentest", "Phishing", "WebApp"]}
      },
      "key": "IP",
      "host": ["DNSHostnames", "Hostname"],
      "ip": "IP",
      "matchIp": true,
      "os": "OS",
      "deviceType": "Device",
      "lastSeen": "pentest.completedAt",
      "staleDays": 90,
      "weaknesses": "NumWeaknesses",
      "confirmedWeaknesses": "NumConfirmedWeaknesses",
      "required": false,
      "discovery": true,
      "activeLabel": "Seen",
      "missingLabel": "Not seen"
    }
  ]
}
