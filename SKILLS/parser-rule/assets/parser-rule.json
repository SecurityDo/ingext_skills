{
  "id": 0,
  "name": "O365_AzureAD_UserLoggedIn_local",
  "group": "Office365",
  "description": "A behavior rule to track UserLoggedIn operations in Azure Active Directory, by UserId.\n\nThis rule indicates the first occurrence of a successful login by the UserId, the login ISP, and login Country.\nAdditionally, this rule also examines the first occurrence of a login ISP within the entity scope.\n\nNotes:\nLogonError - UserAccountNotFound, InvalidPasswordExpiredPassword, and UserInformationNotProvided events are excluded\nUserType - 0\nExcludes ISP - Microsoft Corporation",
  "disabled": false,
  "enableTotal": false,
  "eventType": "event",
  "resourceType": "",
  "aggregationBucket": false,
  "isProcessor": false,
  "processor": "",
  "ruleGroup": "",
  "timeSlices": [
    "1d",
    "1h",
    "1m"
  ],
  "eventSelector": {
    "matchAll": false,
    "eventFilter": "_na_:_na_",
    "query": {
      "term": {
        "_na_": "_na_"
      }
    },
    "mustFilters": [],
    "mustNotFilters": [],
    "jsonQuery": null,
    "lvdbQueryFlag": false
  },
  "behaviorRule": {
    "name": "O365_AzureAD_UserLoggedIn_local",
    "behavior": "application activity",
    "description": "{{.Username}} logged in from {{.ClientIP}} of {{.ISP}} in {{.Country}}",
    "keyType": "username",
    "key": "@fields.UserId",
    "timelineFlag": true,
    "caseFlag": false,
    "fields": [
