      "@fields._ip.country",
      "@fields._ip.isp",
      "@fields.Operation",
      "@fields.DevicePropertiesFields.OS",
      "@fields.UserId",
      "@fields.Workload"
    ],
    "rules": [
      {
        "name": "NewISP",
        "type": "first",
        "description": "",
        "first": {
          "window": {
            "unit": "day",
            "length": 30,
            "text": "30d"
          },
          "fields": [
            "@fields._ip.isp"
          ],
          "localScope": true
        },
        "caseFlag": false,
        "risks": [
