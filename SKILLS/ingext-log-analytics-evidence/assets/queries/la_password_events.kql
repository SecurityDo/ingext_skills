// Log Analytics path. Was the password actually changed, and where? A hybrid
// (AD-synced) account's on-prem reset is logged only by Defender for Identity
// (IdentityDirectoryEvents), never in Entra AuditLogs, and a reset made with
// "must change at next logon" is NOT synced to Entra unless the tenant has enabled
// UserForcePasswordChangeOnLogonEnabled -- the cloud keeps the old password. So read
// both sides: an on-prem "Account Password changed" with "Account Password expired"
// seconds later, and no matching Entra password event, means the cloud password is
// probably the old one. Session revocations (StsRefreshTokenValidFrom, "Revoke Session
// Tokens") are listed too: they end tokens, they do not change a password.
// Pass rangeFrom = now - 30 days.
// Placeholders: {USER} = UPN.
let UserEmail = "{USER}";
union
    (AuditLogs | where TimeGenerated > ago(30d)
        | where tostring(TargetResources) has UserEmail or tostring(InitiatedBy) has UserEmail
        | where OperationName has_any ("password", "Password", "Revoke", "StsRefreshTokenValidFrom",
            "Disable account", "Enable account", "security info")
        | project Time = TimeGenerated, Source = "Entra AuditLogs", Action = OperationName,
            Result = tostring(Result),
            Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
            Where = tostring(InitiatedBy.user.ipAddress), Detail = substring(tostring(AdditionalDetails), 0, 300)),
    (IdentityDirectoryEvents | where TimeGenerated > ago(30d)
        | where TargetAccountUpn =~ UserEmail or AccountUpn =~ UserEmail
        | project Time = TimeGenerated, Source = "Defender for Identity", Action = ActionType,
            Result = "", Actor = AccountName, Where = DeviceName,
            Detail = substring(tostring(AdditionalFields), 0, 300))
| order by Time asc
| take 1000
