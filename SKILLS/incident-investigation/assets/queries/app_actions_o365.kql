// Actions the application took in Microsoft 365 as itself. The unified audit log writes
// an app-only actor as UserId "ServicePrincipal_<servicePrincipalId>".
// Match it with exact equality: `has "<guid>"` on that value returned 0 rows where the
// equality returned 119 for the same principal.
// Placeholders: {SPID} = lower-cased service-principal object id.
Office365
| where timestamp > ago(30d)
| where tolower(UserId) == "serviceprincipal_{SPID}"
| project timestamp, Workload, Operation, UserId, ObjectId, ClientIP,
    ResultStatus, ModifiedProperties
// Dedup: the datalake returns the same event two or more times (one 30-day
// audit pull: 981 rows, 35 distinct). dups = how many copies each row had.
| extend Workload = tostring(Workload), Operation = tostring(Operation),
    UserId = tostring(UserId), ObjectId = tostring(ObjectId),
    ClientIP = tostring(ClientIP), ResultStatus = tostring(ResultStatus),
    ModifiedProperties = tostring(ModifiedProperties)
| summarize dups = count() by timestamp, Workload, Operation, UserId, ObjectId,
    ClientIP, ResultStatus, ModifiedProperties
| top 1000 by timestamp desc
| order by timestamp asc
