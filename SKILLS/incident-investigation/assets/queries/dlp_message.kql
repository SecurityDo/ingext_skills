// What a DLP match was about: the message (sender, recipients, subject) or the file
// (name, path, owner, who shared it, whether outsiders can see it), what matched and in
// which mode. One row per message or file and rule. The operation is spelled
// "DlpRuleMatch" for Exchange and "DLPRuleMatch" for SharePoint, OneDrive and other
// workloads, so it is matched case-insensitively; an exact match sees mail only.
// Mail: UserId is the mailbox the policy evaluated, usually the sender; read the direction
// from From, never from the subject line ("FW:" and "RE:" say nothing about it).
// Files: From is the user or app that wrote the file (APP@SHAREPOINT for a service);
// ExternalVisible is the file's IsViewableByExternalUsers. AccessScope
// IncludeExternalUsers means at least one recipient or viewer can be outside the
// organization. RuleMode Test* is log only: nothing was blocked and nobody was told.
// Locations names the attachment or "Message Body" that held each sensitive type (mail);
// Detected is a sample of the matched values, so a placeholder or test value shows here.
// Exchange logs each match twice; the summarize folds the copies, so don't count rows as
// messages before it.
// Placeholders: {USER} = the mailbox or user UPN, lower-cased; {WFROM}/{WTO}.
Office365
| where timestamp between (datetime("{WFROM}") .. datetime("{WTO}"))
| where Operation =~ "DlpRuleMatch" and tolower(tostring(UserId)) == "{USER}"
| extend Workload = tostring(Workload), m = parse_json(tostring(ExchangeMetaData)),
         f = parse_json(tostring(SharePointMetaData))
| extend IsMail = Workload == "Exchange"
| extend From = iff(IsMail, tostring(m.From), tostring(f.From)),
         To = tostring(m.To), CC = tostring(m.CC), BCC = tostring(m.BCC),
         Subject = tostring(m.Subject), Sent = tostring(m.Sent),
         Object = iff(IsMail, tostring(m.MessageID), tostring(f.FilePathUrl)),
         FileOwner = tostring(f.FileOwner), SharedBy = tostring(f.SharedBy),
         ExternalVisible = tostring(f.IsViewableByExternalUsers),
         Labels = tostring(f.SensitivityLabelNames)
| mv-expand p = parse_json(tostring(PolicyDetails))
| mv-expand r = p.Rules
| extend Policy = tostring(p.PolicyName), Rule = tostring(r.RuleName),
         RuleMode = tostring(r.RuleMode), Severity = tostring(r.Severity),
         Actions = tostring(r.Actions),
         AccessScope = tostring(r.ConditionsMatched.OtherConditions)
| mv-expand s = r.ConditionsMatched.SensitiveInformation
| extend SensitiveType = tostring(s.SensitiveInformationTypeName),
         Location = tostring(s.Location),
         Value = substring(tostring(s.SensitiveInformationDetections.DetectedValues[0].Name), 0, 80)
| summarize first = min(timestamp), Types = make_set(SensitiveType),
    Locations = make_set(Location), Detected = make_set_if(Value, isnotempty(Value), 5)
    by Workload, Object, Sent, From, To, CC, BCC, Subject, FileOwner, SharedBy,
       ExternalVisible, Labels, Policy, Rule, RuleMode, Severity, Actions, AccessScope
| order by first asc
| take 1000
