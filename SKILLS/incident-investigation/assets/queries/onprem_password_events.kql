// On a synced (hybrid) account, Entra logs an on-prem password change as
// "Change user password" by the directory-sync account, which hides WHO changed
// it. The domain controllers' Security log names them: 4724 an admin reset
// (SubjectUserName = the admin), 4723 the user's own change, 4740 a lockout,
// 4767 an unlock, 4771 Status 0x18 a wrong password, 4768 Status 0x0 the first
// good Kerberos logon after it. EventTime is the DC's LOCAL time with no zone:
// convert it before lining it up with UTC rows (the 4768 that matches the Entra
// sync row to the second gives the offset).
// Placeholders: {SAM} = the on-prem account name (TargetUserName), lower-cased;
// {FROM}/{TO} = epoch ms, no wider than 30 days.
WindowsAudit
| where timestamp between (unixtime_milliseconds_todatetime({FROM}) .. unixtime_milliseconds_todatetime({TO}))
| where toint(EventID) in (4723, 4724, 4738, 4740, 4767, 4768, 4771, 4776)
| where tolower(tostring(TargetUserName)) == "{SAM}"
| project timestamp, EventTime = tostring(EventTime), EventID = toint(EventID),
    Description = tostring(EventIDDescription), Hostname = tostring(Hostname),
    SubjectUserName = tostring(SubjectUserName), TargetUserName = tostring(TargetUserName),
    Status = tostring(Status), IpAddress = tostring(IpAddress),
    WorkstationName = tostring(WorkstationName)
| summarize dups = count() by timestamp, EventTime, EventID, Description, Hostname,
    SubjectUserName, TargetUserName, Status, IpAddress, WorkstationName
| top 1000 by timestamp desc
| order by timestamp asc
