// Who reset or changed the subject's password. AzureAuditLogs often leaves the
// initiator of a reset empty; the Office365 copy of the same event names it in Actor,
// a list of IDs whose Type 1 entry is the display name. The readings:
//   "Microsoft password reset service"   self-service password reset (SSPR): whoever
//                                         passed the account's SSPR methods
//   an admin's UPN                         an admin reset it
//   "ConnectSyncProvisioning_*", sync      an on-prem change synced up (on-prem path)
// Office365 is the biggest table on most tenants (3 days was ~110 s on one): set the
// window to about 10 minutes either side of the AzureAuditLogs row, not the ticket's.
// Placeholders: {USER} = the UPN, lower-cased; {WFROM}/{WTO}.
Office365
| where timestamp between (datetime("{WFROM}") .. datetime("{WTO}"))
| where Workload == "AzureActiveDirectory"
| where Operation in ("Reset user password.", "Change user password.",
                      "Change password (self-service).", "Update PasswordProfile.",
                      "Set force change user password.")
| where tolower(tostring(ObjectId)) == "{USER}"
| project timestamp, Operation, UserId, ResultStatus, Actor = tostring(Actor),
          ActorIP = tostring(ActorIpAddress), ClientIP = tostring(ClientIP)
| order by timestamp asc
| take 1000
