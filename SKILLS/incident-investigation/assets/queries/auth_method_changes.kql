// The fact that decides an MFA / passkey registration case, and the one neither
// the behavior summary nor the sign-in log contains: WHICH DEVICE APPROVED IT.
// StrongAuthenticationPhoneAppDetail carries the registered authenticator list;
// compare its OldValue against NewValue. A device already present in OldValue
// means an enrolled factor approved the change and the account was not taken
// over. SearchableDeviceKey carries the FIDO key that was written.
// Placeholders: {TARGET} = the UPN as ObjectId spells it, {FROM}/{TO} = epoch ms.
Office365
| where timestamp between (unixtime_milliseconds_todatetime({FROM}) .. unixtime_milliseconds_todatetime({TO}))
// Workload and Operation first: every auth-method effect is an "Update user." row
// (jedunn, 4 h of 10-26: all StrongAuthentication*/SearchableDeviceKey rows), and
// filtering on them before the ObjectId text scan is 10x faster (6 h: 8 s, not 76 s).
| where Workload == "AzureActiveDirectory" and Operation == "Update user."
| where tostring(ObjectId) contains "{TARGET}"
| project timestamp, Operation, UserId, ObjectId, ModifiedProperties
// Dedup: the datalake returns the same event two or more times (one 30-day
// audit pull: 981 rows, 35 distinct). dups = how many copies each row had.
| extend Operation = tostring(Operation), UserId = tostring(UserId),
    ObjectId = tostring(ObjectId), ModifiedProperties = tostring(ModifiedProperties)
| summarize dups = count() by timestamp, Operation, UserId, ObjectId,
    ModifiedProperties
| top 1000 by timestamp desc
| order by timestamp asc
