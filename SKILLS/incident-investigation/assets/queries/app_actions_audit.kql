// Directory changes the application made AS ITSELF -- the audit trail of its secret or
// certificate being used against Entra ID. InitiatedBy.app usually carries only the
// servicePrincipalId (appId is often empty), so match both.
// Placeholders: {APPID} = lower-cased appId, {SPID} = lower-cased service-principal
// object id (the target id of the "Add service principal" audit event).
AzureAuditLogs
| where TimeGenerated > ago(30d)
| extend InitiatedAppId = tolower(tostring(InitiatedBy.app.appId)),
         InitiatedSpId = tolower(tostring(InitiatedBy.app.servicePrincipalId)),
         InitiatedApp = tostring(InitiatedBy.app.displayName)
| where InitiatedAppId == "{APPID}" or InitiatedSpId == "{SPID}"
| project TimeGenerated, ActivityDisplayName, Category, Result, ResultReason,
    InitiatedApp, InitiatedAppId, InitiatedSpId, TargetResources,
    AdditionalDetails, CorrelationId
// Dedup: the datalake returns the same event two or more times (one 30-day
// audit pull: 981 rows, 35 distinct). dups = how many copies each row had.
| extend ActivityDisplayName = tostring(ActivityDisplayName),
    Category = tostring(Category), Result = tostring(Result),
    ResultReason = tostring(ResultReason), InitiatedApp = tostring(InitiatedApp),
    InitiatedAppId = tostring(InitiatedAppId),
    InitiatedSpId = tostring(InitiatedSpId),
    TargetResources = tostring(TargetResources),
    AdditionalDetails = tostring(AdditionalDetails),
    CorrelationId = tostring(CorrelationId)
| summarize dups = count() by TimeGenerated, ActivityDisplayName, Category, Result,
    ResultReason, InitiatedApp, InitiatedAppId, InitiatedSpId, TargetResources,
    AdditionalDetails, CorrelationId
| top 1000 by TimeGenerated desc
| order by TimeGenerated asc
