// Before calling a proxy address "attacker infrastructure", check whether other
// users in the same tenant sit behind the same provider. Three unrelated
// employees on one Cloudflare /32 with Apple user-agents is iCloud Private
// Relay, not C2. Placeholders: {PREFIX} = e.g. "2a09:bac2:", {UA} = e.g. "iPad".
AzureSigninLogs
| where TimeGenerated > ago(30d)
| where IPAddress startswith "{PREFIX}" or UserAgent contains "{UA}"
| extend City = tostring(LocationDetails.city)
| project TimeGenerated, UserPrincipalName, IPAddress, City, AppDisplayName,
    UserAgent, ResultType, IsInteractive, AuthenticationRequirement
// Dedup: the datalake returns the same event two or more times (one 30-day
// audit pull: 981 rows, 35 distinct). dups = how many copies each row had.
| extend UserPrincipalName = tostring(UserPrincipalName),
    IPAddress = tostring(IPAddress), City = tostring(City),
    AppDisplayName = tostring(AppDisplayName), UserAgent = tostring(UserAgent),
    ResultType = tostring(ResultType), IsInteractive = tostring(IsInteractive),
    AuthenticationRequirement = tostring(AuthenticationRequirement)
| summarize dups = count() by TimeGenerated, UserPrincipalName, IPAddress, City,
    AppDisplayName, UserAgent, ResultType, IsInteractive, AuthenticationRequirement
| top 1000 by TimeGenerated desc
| order by TimeGenerated asc
