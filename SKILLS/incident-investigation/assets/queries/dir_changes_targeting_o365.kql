// FALLBACK for dir_changes_targeting.kql when the tenant has no AzureAuditLogs.
// Core Directory events only: PIM activations, security-info changes and
// self-service password resets done to the subject are NOT in Office365.
// Directory changes made TO the subject by someone else -- group and role adds,
// password resets, licence and device changes. One row per operation
// (Operation = InterSystemsId, the AzureAuditLogs CorrelationId). Changes lists
// every modified property as "name: old -> new", each value cut to 80 characters:
// a removal carries the group or role in the OLD value. Read the group's real
// name before calling a membership add privilege escalation.
// Object-id and template-id properties are dropped from Changes; the full row is
// in dir_changes_detail_o365.kql. There is no initiator IP on these rows.
// Placeholders: {USER} = lower-cased UPN.
let UserEmail = tolower("{USER}");
Office365
| where timestamp > ago(30d)
| where Workload == "AzureActiveDirectory" and RecordType == 8
| extend Initiator = tolower(tostring(UserId)), InitiatorName = tostring(Actor[0].ID)
| where tolower(tostring(Target)) has UserEmail and Initiator != UserEmail
| mv-expand mp = ModifiedProperties
| extend Name = tostring(mp.Name)
| extend Change = iff(Name == "" or Name endswith "ObjectID" or Name endswith "TemplateId"
                      or Name endswith "objectId" or Name == "Included Updated Properties", "",
             strcat(Name, ": ", substring(tostring(mp.OldValue), 0, 80),
                    " -> ", substring(tostring(mp.NewValue), 0, 80)))
| summarize Changes = make_set(Change)
    by timestamp, Operation = tostring(Operation), ResultStatus = tostring(ResultStatus),
       Initiator, InitiatorName, ObjectId = tostring(ObjectId),
       InterSystemsId = tostring(InterSystemsId)
| top 1000 by timestamp desc
| order by timestamp asc
