// Decompose "N failed logins" by error code and origin before calling it a
// brute force. Only 50126 is a credential failure; 50074 is a strong-auth
// interrupt inside a normal flow and 70044 is an expired session. Where the
// failure came from settles it: failures on the user's own compliant,
// Entra-joined device from the corporate egress, followed by success seconds
// later, are a typo. Placeholders: {USER} = lower-cased UPN.
Office365
| where timestamp > ago(30d)
| where tolower(UserId) == "{USER}"
| where Operation in ("UserLoginFailed", "UserLoggedIn")
| project timestamp, Operation, ClientIP, ErrorNumber, ["_ip.isp"], ["_ip.city"],
    ["DevicePropertiesFields.OS"], ["DevicePropertiesFields.BrowserType"],
    ["ExtendedPropertiesFields.RequestType"], ApplicationId, ResultStatus
// Dedup: the datalake returns the same event two or more times (one 30-day
// audit pull: 981 rows, 35 distinct). dups = how many copies each row had.
| extend Operation = tostring(Operation), ClientIP = tostring(ClientIP),
    ErrorNumber = tostring(ErrorNumber), ["_ip.isp"] = tostring(["_ip.isp"]),
    ["_ip.city"] = tostring(["_ip.city"]),
    ["DevicePropertiesFields.OS"] = tostring(["DevicePropertiesFields.OS"]),
    ["DevicePropertiesFields.BrowserType"] = tostring(["DevicePropertiesFields.BrowserType"]),
    ["ExtendedPropertiesFields.RequestType"] = tostring(["ExtendedPropertiesFields.RequestType"]),
    ApplicationId = tostring(ApplicationId), ResultStatus = tostring(ResultStatus)
| summarize dups = count() by timestamp, Operation, ClientIP, ErrorNumber,
    ["_ip.isp"], ["_ip.city"], ["DevicePropertiesFields.OS"],
    ["DevicePropertiesFields.BrowserType"], ["ExtendedPropertiesFields.RequestType"],
    ApplicationId, ResultStatus
| top 1000 by timestamp desc
| order by timestamp asc
