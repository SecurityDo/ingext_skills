// K3 -- one campaign or several? Addresses whose failed legacy / no-user-agent
// sign-ins hit more than one account. Shared infrastructure across the accounts
// K3's census found makes them one campaign, and one fix. realAccounts = existing
// accounts hit; unknownNames = usernames that do not exist in the org (VERIFICATION_ERROR /
// UNKNOWN_USER, actor.id "unknown"): a list-driven spray, not wrong passwords.
// Counts only.
Okta
| where timestamp between (datetime("{WTO}") - 30d .. datetime("{WTO}"))
| where tostring(["outcome.result"]) == "FAILURE"
| where eventType in ("user.session.start", "user.authentication.auth_via_richclient")
| extend uri = tostring(["debugContext.debugData.requestUri"]),
    ua = tostring(["client.userAgent.rawUserAgent"])
| where eventType == "user.authentication.auth_via_richclient" or uri contains "/sso/wsfed/active"
    or ua == "unknown" or ua == ""
| extend unknownUser = tostring(["outcome.reason"]) in ("VERIFICATION_ERROR", "UNKNOWN_USER")
    or tostring(["actor.id"]) == "unknown",
    who = tolower(tostring(["actor.alternateId"]))
| summarize realAccounts = dcountif(who, not(unknownUser)), unknownNames = dcountif(who, unknownUser),
    accounts = dcount(tolower(tostring(["actor.alternateId"]))),
    actors = make_set(tolower(tostring(["actor.alternateId"])), 10), attempts = dcount(uuid),
    country = min(tostring(["client.geographicalContext.country"])),
    first = min(timestamp), last = max(timestamp)
    by ip = tostring(["client.ipAddress"])
| where accounts > 1
| order by accounts desc, attempts desc
| take 1000
