// Has anyone signed in TO the application? A just-registered app that requests delegated
// permissions is used through user sign-ins, and those land here keyed on its appId.
// AzureSigninLogs holds USER (interactive/delegated) sign-ins only: a client-credentials
// sign-in with the app's own secret or certificate is a service-principal sign-in and is
// NOT in this table. Zero rows here therefore says "no user has signed in to it", never
// "the secret has not been used" -- see the workflow's app-activity check.
// Placeholders: {APPID} = lower-cased appId.
AzureSigninLogs
| where TimeGenerated > ago(30d)
| where tolower(AppId) == "{APPID}"
| project TimeGenerated, UserPrincipalName, AppDisplayName, AppId, IPAddress,
    ResultType, ResultDescription, ClientAppUsed, UserAgent, ResourceDisplayName,
    ConditionalAccessStatus, AuthenticationRequirement, CorrelationId
// Dedup: the datalake returns the same event two or more times (one 30-day
// audit pull: 981 rows, 35 distinct). dups = how many copies each row had.
| extend UserPrincipalName = tostring(UserPrincipalName),
    AppDisplayName = tostring(AppDisplayName), AppId = tostring(AppId),
    IPAddress = tostring(IPAddress), ResultType = tostring(ResultType),
    ResultDescription = tostring(ResultDescription),
    ClientAppUsed = tostring(ClientAppUsed), UserAgent = tostring(UserAgent),
    ResourceDisplayName = tostring(ResourceDisplayName),
    ConditionalAccessStatus = tostring(ConditionalAccessStatus),
    AuthenticationRequirement = tostring(AuthenticationRequirement),
    CorrelationId = tostring(CorrelationId)
| summarize dups = count() by TimeGenerated, UserPrincipalName, AppDisplayName,
    AppId, IPAddress, ResultType, ResultDescription, ClientAppUsed, UserAgent,
    ResourceDisplayName, ConditionalAccessStatus, AuthenticationRequirement,
    CorrelationId
| top 1000 by TimeGenerated desc
| order by TimeGenerated asc
